// Function object Ffowcs-Williams & Hawkings (libAcoustics)
// Source surface = the blades (patch helice) -> loading noise (dipole, tonal)
// ---------------------------------------------------------------------------
FWH_helice
{
    type            FfowcsWilliamsHawkings;
    formulationType Farassat1AFormulation;   // Farassat formulation 1A (standard)

    #include        "commonSettings";

    patches         ();
    interpolationScheme cellPoint;

    // Acoustic surface = the blade skin (rotating)
    surfaces
    (
        helice
        {
            type        patch;
            patches     (helice);
            interpolate false;
        }
    );

    cleanFreq               100;
    nonUniformSurfaceMotion true;     // the surface (blades) rotates
    Ufwh    (0 0 0);
    U0      (0 0 0);                  // no imposed mean flow (fan in still air)
    fixedResponseDelay      false;
    responseDelay           0.01;
}
