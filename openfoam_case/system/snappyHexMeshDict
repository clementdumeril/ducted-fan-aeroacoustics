/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM snappyHexMeshDict - ventilo_sst_mesh_v2_stable                    |
// Dictionary of the 1.95 M-cell mesh described in paper/main.pdf (blades at level 5), cluster case ventilo_sst_mesh_v2_stable.
// The earlier 0.91 M-cell local mesh used snappyHexMeshDict.baseline_0p91M.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    helice.stl { type triSurfaceMesh; name helice; }
    carter.stl { type triSurfaceMesh; name carter; }
    moteur.stl { type triSurfaceMesh; name moteur; }
    bras.stl   { type triSurfaceMesh; name bras;   }

    // Same AMI cylinder as V1. It creates the rotating cellZone/faceZone.
    rotatingZone
    {
        type        searchableCylinder;
        point1      (0 0 -0.013);
        point2      (0 0  0.014);
        radius      0.072;
    }

    // Strong refinement around the rotor disk and blade tips.
    rotorRefinement
    {
        type        searchableCylinder;
        point1      (0 0 -0.020);
        point2      (0 0  0.022);
        radius      0.088;
    }

    // Wake refinement downstream of the fan. Axis is +Z in this case.
    wakeRefinement
    {
        type        searchableCylinder;
        point1      (0 0  0.010);
        point2      (0 0  0.170);
        radius      0.105;
    }
}

castellatedMeshControls
{
    maxLocalCells       1800000;
    maxGlobalCells      5500000;
    minRefinementCells  10;
    nCellsBetweenLevels 4;
    resolveFeatureAngle 25;
    allowFreeStandingZoneFaces true;

    features
    (
        { file "helice.eMesh"; level 4; }
        { file "carter.eMesh"; level 3; }
        { file "moteur.eMesh"; level 2; }
        { file "bras.eMesh";   level 3; }
    );

    refinementSurfaces
    {
        // Main change vs V1: much finer blade surface.
        helice { level (4 5); patchInfo { type wall; } }
        carter { level (2 3); patchInfo { type wall; } }
        moteur { level (2 2); patchInfo { type wall; } }
        bras   { level (2 3); patchInfo { type wall; } }

        rotatingZone
        {
            level (0 0);
            faceZone        rotatingZone;
            cellZone        rotatingZone;
            cellZoneInside  inside;
            faceType        internal;
        }
    }

    refinementRegions
    {
        rotatingZone    { mode inside; levels ((1E15 2)); }
        rotorRefinement { mode inside; levels ((1E15 3)); }
        wakeRefinement  { mode inside; levels ((1E15 2)); }
    }

    locationInMesh (0.15 0.0 0.0);
}

snapControls
{
    // Limited snap: the available STL is already faceted, so too many feature
    // snap iterations over-attract points and create local twisted faces.
    nSmoothPatch    4;
    tolerance       1.2;
    nSolveIter      45;
    nRelaxIter      6;
    nFeatureSnapIter 8;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

// Boundary layers are disabled in this stable pass. The geometry available here
// was reconstructed from the old boundary mesh, and forced layers collapse over
// most blade faces. Keep the block for a future CAD/STL-clean pass.
addLayersControls
{
    relativeSizes       true;

    layers
    {
        helice { nSurfaceLayers 4; }
        carter { nSurfaceLayers 3; }
        moteur { nSurfaceLayers 2; }
        bras   { nSurfaceLayers 2; }
    }

    expansionRatio      1.18;
    finalLayerThickness 0.25;
    minThickness        0.015;

    nGrow                   1;
    featureAngle            65;
    slipFeatureAngle        30;
    nRelaxIter              8;
    nSmoothSurfaceNormals   3;
    nSmoothNormals          5;
    nSmoothThickness        12;
    maxFaceThicknessRatio   0.45;
    maxThicknessToMedialRatio 0.45;
    minMedialAxisAngle      90;
    nBufferCellsNoExtrude   1;
    nLayerIter              80;
    nRelaxedIter            25;
}

meshQualityControls
{
    #includeEtc "caseDicts/meshQualityDict"

    nSmoothScale    4;
    errorReduction  0.75;

    relaxed
    {
        maxNonOrtho 75;
        maxBoundarySkewness 20;
        maxInternalSkewness 8;
    }
}

writeFlags ( scalarLevels layerSets layerFields );
mergeTolerance 1e-6;

// ************************************************************************* //
