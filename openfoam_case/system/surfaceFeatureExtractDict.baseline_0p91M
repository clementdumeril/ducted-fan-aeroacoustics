FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Feature edge = angle between 2 neighbouring facets > includedAngle.
// 150 deg -> keeps the real sharp edges, ignores fine faceting.

helice.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       150;
    writeObj            yes;
}

carter.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       150;
    writeObj            yes;
}

moteur.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       150;
    writeObj            yes;
}

bras.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       150;
    writeObj            yes;
}


