// Reglages communs FW-H (inclus par fwhControl)
// ---------------------------------------------------------------------------
        libs ("libAcoustics.so");

        log             true;

        probeFrequency  5;        // echantillonne tous les 5 pas (dt=1e-4 -> Nyquist ~1kHz, OK tonal) ; ÷5 cout FW-H

        timeStart       0;        // on enregistre tout ; on choisira la fenetre FFT en post
        timeEnd         10;

        writeFft        false;    // on fera la FFT en post (plus de controle)

        c0              343;      // celerite du son dans l'air (m/s)
        pName           p;
        pInf            0;
        rhoName         rhoInf;   // incompressible -> densite constante
        rho             rhoInf;
        rhoInf          1.2;      // air (kg/m3)

        CofR            (0 0 0);  // centre de rotation (= axe du rotor)

        // --- MICROS VIRTUELS (en metres ; peuvent etre HORS du domaine) ---
        observers
        {
            aval_1m            // 1 m en aval, sur l'axe (cote refoulement)
            {
                position   (0 0 1.0);
                pRef       0.000020;   // 20 uPa : reference SPL
                fftFreq    1024;
            }
            amont_1m           // 1 m en amont, sur l'axe (cote aspiration)
            {
                position   (0 0 -1.0);
                pRef       0.000020;
                fftFreq    1024;
            }
            radial_1m          // 1 m sur le cote (perpendiculaire a l'axe)
            {
                position   (1.0 0 0);
                pRef       0.000020;
                fftFreq    1024;
            }
            diag45_1m          // 1 m a 45 deg (aval + cote) -> directivite
            {
                position   (0.707 0 0.707);
                pRef       0.000020;
                fftFreq    1024;
            }
        }
