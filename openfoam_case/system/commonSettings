// Common FW-H settings (included by fwhControl)
// ---------------------------------------------------------------------------
        libs ("libAcoustics.so");

        log             true;

        probeFrequency  5;        // samples every 5 steps (phase 2 dt = 3.5e-5 s -> fs = 5714 Hz); cuts the FW-H cost by 5

        timeStart       0;        // record everything; the FFT window is chosen in post-processing
        timeEnd         10;

        writeFft        false;    // FFT done in post-processing (more control)

        c0              343;      // speed of sound in air (m/s)
        pName           p;
        pInf            0;
        rhoName         rhoInf;   // incompressible -> constant density
        rho             rhoInf;
        rhoInf          1.2;      // air (kg/m3)

        CofR            (0 0 0);  // centre of rotation (rotor axis)

        // --- virtual microphones (metres; may lie outside the domain) ---
        observers
        {
            aval_1m            // 1 m downstream, on the axis (discharge side)
            {
                position   (0 0 1.0);
                pRef       0.000020;   // 20 uPa: SPL reference
                fftFreq    1024;
            }
            amont_1m           // 1 m upstream, on the axis (suction side)
            {
                position   (0 0 -1.0);
                pRef       0.000020;
                fftFreq    1024;
            }
            radial_1m          // 1 m to the side (perpendicular to the axis)
            {
                position   (1.0 0 0);
                pRef       0.000020;
                fftFreq    1024;
            }
            diag45_1m          // 1 m at 45 deg (downstream + side) -> directivity
            {
                position   (0.707 0 0.707);
                pRef       0.000020;
                fftFreq    1024;
            }
        }
