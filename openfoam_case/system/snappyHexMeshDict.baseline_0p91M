FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;    // boundary layers requested (inserted on the casing, not on the thin blades)

// ---------------------------------------------------------------------------
geometry
{
    helice.stl { type triSurfaceMesh; name helice; }
    carter.stl { type triSurfaceMesh; name carter; }
    moteur.stl { type triSurfaceMesh; name moteur; }
    bras.stl   { type triSurfaceMesh; name bras;   }

    // AMI cylinder: R = 72 mm (between blade tip 69.2 and casing 76);
    // z = [-13; +14] mm: encloses the blades z = [-11; 13.31], top disc in the
    // CAD gap between blades and front hub (z = [13.31; 14.68]), bottom disc below the blades.
    rotatingZone
    {
        type        searchableCylinder;
        point1      (0 0 -0.013);
        point2      (0 0  0.014);
        radius      0.072;
    }
}

// ---------------------------------------------------------------------------
castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      6000000;
    minRefinementCells  10;
    nCellsBetweenLevels 3;
    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces true;

    features
    (
        { file "helice.eMesh"; level 4; }
        { file "carter.eMesh"; level 3; }
        { file "moteur.eMesh"; level 2; }
        { file "bras.eMesh";   level 3; }
    );

    refinementSurfaces
    {
        helice { level (3 4); patchInfo { type wall; } }
        carter { level (2 3); patchInfo { type wall; } }
        moteur { level (2 2); patchInfo { type wall; } }
        bras   { level (2 3); patchInfo { type wall; } }

        rotatingZone
        {
            level (0 0);
            faceZone        rotatingZone;
            cellZone        rotatingZone;
            cellZoneInside  inside;
            faceType        internal;
        }
    }

    refinementRegions
    {
        rotatingZone { mode inside; levels ((1E15 2)); }
    }

    // Point in the FLUID: away from all solids (to the side, outside the casing)
    locationInMesh (0.15 0.0 0.0);
}

// ---------------------------------------------------------------------------
snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

// ---------------------------------------------------------------------------
addLayersControls
{
    // sizes RELATIVE to the local cell (easier to tune)
    relativeSizes       true;

    // Layers per wall: 3 on the blades (noise source) and the
    // casing; 2 on the motor and arms (less critical). Start modest
    // to MAXIMISE the insertion rate (thin blades are difficult).
    layers
    {
        helice { nSurfaceLayers 2; }   // 2 (instead of 3): thin blade
        carter { nSurfaceLayers 3; }   // works well (90 %)
        moteur { nSurfaceLayers 2; }
        bras   { nSurfaceLayers 2; }
    }

    expansionRatio      1.2;     // each layer 1.2x thicker than the previous one
    finalLayerThickness 0.35;    // THINNER layers -> fit in tight regions
    minThickness        0.01;    // low threshold -> insert even thin layers

    // --- settings that HELP insertion on thin/curved geometry ---
    nGrow                   0;
    featureAngle            70;   // keep layers up to 70 deg (blade edges)
    slipFeatureAngle        30;
    nRelaxIter              5;
    nSmoothSurfaceNormals   1;
    nSmoothNormals          3;
    nSmoothThickness        10;
    maxFaceThicknessRatio   0.5;
    maxThicknessToMedialRatio 0.5;   // less aggressive -> keeps layers on thin blades
    minMedialAxisAngle      90;
    nBufferCellsNoExtrude   0;
    nLayerIter              50;
    nRelaxedIter            20;   // retry with relaxed criteria if the strict pass fails
}

// ---------------------------------------------------------------------------
meshQualityControls
{
    #includeEtc "caseDicts/meshQualityDict"

    nSmoothScale    4;
    errorReduction  0.75;

    // RELAXED criteria, used during the last nRelaxedIter
    // layer iterations (tolerate a bit more to insert more layers)
    relaxed
    {
        maxNonOrtho 75;
    }
}

writeFlags ( scalarLevels layerSets layerFields );
mergeTolerance 1e-6;


