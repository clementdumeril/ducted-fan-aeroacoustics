FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Correction de flux pour le maillage mobile (AMI)
    "pcorr.*"
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-4;
        relTol          0;
    }

    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.1;
    }

    "(U|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    correctPhi          yes;        // indispensable : maillage mobile
    nOuterCorrectors    3;          // 3 correcteurs : compromis stabilite/vitesse
    nCorrectors         2;
    nNonOrthogonalCorrectors 1;
    momentumPredictor   yes;
}

relaxationFactors
{
    equations
    {
        "U.*"           0.9;
        "(k|omega).*"   0.8;
        ".*Final"       1.0;
    }
}


