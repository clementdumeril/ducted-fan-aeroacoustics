FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;   // STL already in metres

// Open air domain around the fan.
// The fan fits within ~0.1 m radius; the box is taken wide.
// x,y: +/- 0.20 m (~2.6 x fan radius)
// z: -0.20 (upstream, suction) -> +0.30 (downstream, discharge)
// Flow assumed axial along +Z (casing lip at z<0 -> diffuser at z>0).

vertices
(
    (-0.20 -0.20 -0.20)   // 0
    ( 0.20 -0.20 -0.20)   // 1
    ( 0.20  0.20 -0.20)   // 2
    (-0.20  0.20 -0.20)   // 3
    (-0.20 -0.20  0.30)   // 4
    ( 0.20 -0.20  0.30)   // 5
    ( 0.20  0.20  0.30)   // 6
    (-0.20  0.20  0.30)   // 7
);

// Background cells ~10 mm: 40 x 40 x 50 cells
blocks
(
    hex (0 1 2 3 4 5 6 7) (40 40 50) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet                       // face z = -0.20 (suction side)
    {
        type patch;
        faces ( (0 3 2 1) );
    }
    outlet                      // face z = +0.30 (discharge side)
    {
        type patch;
        faces ( (4 5 6 7) );
    }
    farfield                    // 4 side faces (open air)
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
        );
    }
);


