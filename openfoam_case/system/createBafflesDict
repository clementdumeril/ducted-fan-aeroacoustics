FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createBafflesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Only internal faces are affected (the faceZone of the cylinder)
internalFacesOnly   true;

baffles
{
    // Duplicates the faceZone "rotatingZone" into 2 coincident cyclicAMI patches:
    //   AMI1 (master) on the rotating side  <->  AMI2 (slave) on the static side
    rotatingZone
    {
        type        faceZone;
        zoneName    rotatingZone;

        patches
        {
            master
            {
                name            AMI1;
                type            cyclicAMI;
                neighbourPatch  AMI2;
                transform       noOrdering;
                matchTolerance  1e-4;
            }
            slave
            {
                name            AMI2;
                type            cyclicAMI;
                neighbourPatch  AMI1;
                transform       noOrdering;
                matchTolerance  1e-4;
            }
        }
    }
}


