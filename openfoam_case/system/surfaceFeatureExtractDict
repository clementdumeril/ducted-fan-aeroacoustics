/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM surfaceFeatureExtractDict - ventilo_sst_mesh_v2                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}

// Lower includedAngle than V1 to preserve blade edges from the extracted STL.
// V1 used 150 deg. V2 keeps more leading/trailing/tip features.

helice.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       130;
    writeObj            yes;
}

carter.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       145;
    writeObj            yes;
}

moteur.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       145;
    writeObj            yes;
}

bras.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       145;
    writeObj            yes;
}

