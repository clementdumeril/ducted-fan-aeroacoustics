FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// k = 1.5*(I*Uref)^2, I=5%, Uref~12 m/s -> 0.54 m2/s2
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.54;

boundaryField
{
    inlet
    {
        type            inletOutlet;
        inletValue      uniform 0.54;
        value           uniform 0.54;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.54;
        value           uniform 0.54;
    }
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 0.54;
        value           uniform 0.54;
    }

    helice          { type kqRWallFunction; value uniform 0.54; }
    carter          { type kqRWallFunction; value uniform 0.54; }
    moteur          { type kqRWallFunction; value uniform 0.54; }
    bras            { type kqRWallFunction; value uniform 0.54; }

    "AMI.*"         { type cyclicAMI; }
}


