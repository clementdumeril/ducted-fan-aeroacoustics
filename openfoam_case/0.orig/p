FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// p = kinematic pressure (Pa/rho), incompressible solver
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // Open boundaries: total pressure fixed to 0 (ambient air)
    inlet
    {
        type            totalPressure;
        p0              uniform 0;
        value           uniform 0;
    }
    outlet
    {
        type            totalPressure;
        p0              uniform 0;
        value           uniform 0;
    }
    farfield
    {
        type            totalPressure;
        p0              uniform 0;
        value           uniform 0;
    }

    helice          { type zeroGradient; }
    carter          { type zeroGradient; }
    moteur          { type zeroGradient; }
    bras            { type zeroGradient; }

    "AMI.*"         { type cyclicAMI; }
}


