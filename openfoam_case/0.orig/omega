FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// omega = epsilon/(Cmu*k) = 6.2/(0.09*0.54) ~ 128 /s
dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 128;

boundaryField
{
    inlet
    {
        type            inletOutlet;
        inletValue      uniform 128;
        value           uniform 128;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 128;
        value           uniform 128;
    }
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 128;
        value           uniform 128;
    }

    // omegaWallFunction : gere automatiquement bas-Re ET lois de paroi selon y+
    helice          { type omegaWallFunction; value uniform 128; }
    carter          { type omegaWallFunction; value uniform 128; }
    moteur          { type omegaWallFunction; value uniform 128; }
    bras            { type omegaWallFunction; value uniform 128; }

    "AMI.*"         { type cyclicAMI; }
}


