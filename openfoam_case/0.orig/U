FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Open boundaries: the fan draws in and blows out freely (open air)
    inlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    farfield
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    // Blades: wall moving with the rotating mesh (relative no-slip)
    helice
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    // Static walls
    carter
    {
        type            noSlip;
    }
    moteur
    {
        type            noSlip;
    }
    bras
    {
        type            noSlip;
    }

    // Sliding interface
    "AMI.*"
    {
        type            cyclicAMI;
    }
}


