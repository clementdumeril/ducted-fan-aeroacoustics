FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Moving mesh: only the cell zone "rotatingZone" moves.
dynamicFvMesh   dynamicMotionSolverFvMesh;

motionSolverLibs (fvMotionSolvers);

motionSolver    solidBody;       // the zone rotates as a rigid body

cellZone        rotatingZone;    // <-- cellZone created by snappyHexMesh

solidBodyMotionFunction  rotatingMotion;

origin      (0 0 0);        // rotation axis through the origin
axis        (0 0 1);        // rotation axis = +Z

// Start-up ramp: omega rises from 0 to 158 rad/s over the first 5 ms
// (avoids the pressure wave of an impulsive start, which made the AMI diverge)
omega       table
(
    (0      0)
    (0.005  158)
    (1.0    158)
);


